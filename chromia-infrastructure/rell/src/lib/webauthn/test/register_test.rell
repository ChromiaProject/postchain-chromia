@test module;

import lib.webauthn;
import ^.helper_operations.*;

val challenge = "the challenge is here";
val challenge2 = "the other challenge is there";

val id = "the id".hash();
val id2 = "other id".hash();

function test_register_success(){
    rell.test.tx().op(
        webauthn_register(
            id,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge),
            ["nfc", "usb"],
        ),
        check_register(challenge, id, ["nfc", "usb"]),
    ).run();
}

function test_register_success_double(){
    rell.test.tx().op(
        webauthn_register(
            id,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge),
            ["nfc", "usb"],
        ),
        check_register(challenge, id, ["nfc", "usb"]),
        webauthn_register(
            id2,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge2),
            ["nfc"],
        ),
        check_register(challenge2, id2, ["nfc"]),
    ).run();
}

function test_no_register_op() {
    rell.test.tx().op(
        check_register(challenge, id, ["nfc", "usb"]),
    ).run_must_fail("no gtxc.webauthn_register operation before me in transaction");
}

function test_no_register_op_before() {
    rell.test.tx().op(
        check_register(challenge, id, ["nfc", "usb"]),
        webauthn_register(
            id,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge),
            ["nfc", "usb"],
        ),
    ).run_must_fail("no gtxc.webauthn_register operation before me in transaction");
}

function test_register_wrong_challenge(){
    rell.test.tx().op(
        webauthn_register(
            id,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format("bad challenge"),
            ["nfc", "usb"],
        ),
        check_register(challenge, id, ["nfc", "usb"]),
    ).run_must_fail("wrong challenge");
}

function test_register_wrong_id(){
    rell.test.tx().op(
        webauthn_register(
            x"",
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge),
            ["nfc", "usb"],
        ),
        check_register(challenge, id, ["nfc", "usb"]),
    ).run_must_fail("wrong id");
}

function test_register_wrong_transports(){
    rell.test.tx().op(
        webauthn_register(
            id,
            x"",
            "{\"type\":\"webauthn.create\",\"challenge\":\"%s\"}".format(challenge),
            ["foo", "bar"],
        ),
        check_register(challenge, id, ["nfc", "usb"]),
    ).run_must_fail("wrong transports");
}

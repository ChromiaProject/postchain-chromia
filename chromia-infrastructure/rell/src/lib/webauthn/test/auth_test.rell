@test module;

import lib.webauthn;
import ^.helper_operations.*;

val challenge = "the challenge is here";
val challenge2 = "the other challenge is there";

val id = "the id".hash();
val id2 = "other id".hash();

function test_auth_success(){
    rell.test.tx().op(
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(challenge, id),
    ).run();
}

function test_auth_success_double(){
    rell.test.tx().op(
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(challenge, id),
        webauthn_authenticate(
            id2,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge2),
            x"",
        ),
        check_auth(challenge2, id2),
    ).run();
}

function test_no_auth_op() {
    rell.test.tx().op(
        check_auth(challenge, id),
    ).run_must_fail("no gtxc.webauthn_authenticate operation before me in transaction");
}

function test_no_auth_op_before() {
    rell.test.tx().op(
        check_auth(challenge, id),
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
    ).run_must_fail("no gtxc.webauthn_authenticate operation before me in transaction");
}

function test_auth_wrong_challenge(){
    rell.test.tx().op(
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format("bad challenge"),
            x"",
        ),
        check_auth(challenge, id),
    ).run_must_fail("wrong challenge");
}

function test_auth_wrong_id(){
    rell.test.tx().op(
        webauthn_authenticate(
            id2,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(challenge, id),
    ).run_must_fail("wrong id");
}

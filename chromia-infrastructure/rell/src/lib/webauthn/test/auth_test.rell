@test module;

import lib.webauthn;
import ^.helper_operations.*;

val challenge = "the challenge is here";
val challenge2 = "the other challenge is there";

val id = "the id".hash();
val id2 = "other id".hash();

function test_auth_success(){
    rell.test.tx().op(
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(id),
    ).run();
}

function test_auth_success_double(){
    rell.test.tx().op(
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(id),
        webauthn_authenticate(
            id2,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge2),
            x"",
        ),
        check_auth(id2),
    ).run();
}

function test_no_auth_op() {
    rell.test.tx().op(
        check_auth(id),
    ).run_must_fail("no gtxc.webauthn_authenticate operation before me in transaction");
}

function test_no_auth_op_before() {
    rell.test.tx().op(
        check_auth(id),
        webauthn_authenticate(
            id,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
    ).run_must_fail("no gtxc.webauthn_authenticate operation before me in transaction");
}

function test_auth_wrong_id(){
    rell.test.tx().op(
        webauthn_authenticate(
            id2,
            x"",
            "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge),
            x"",
        ),
        check_auth(id),
    ).run_must_fail("wrong id");
}

val bound_challenge = x"fbffbffbffbffbffbffbffbffbffbff0";
val bound_challenge_b64url = "-_-_-_-_-_-_-_-_-_-_8A";

function client_data(challenge: text) = "{\"type\":\"webauthn.get\",\"challenge\":\"%s\"}".format(challenge);

function test_base64url() {
    assert_equals(webauthn.base64url(bound_challenge), bound_challenge_b64url);
}

function test_auth_for_success() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(bound_challenge_b64url), x""),
        check_auth_for(id, bound_challenge),
    ).run();
}

function test_auth_for_accepts_padding() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(bound_challenge_b64url + "=="), x""),
        check_auth_for(id, bound_challenge),
    ).run();
}

function test_auth_for_rejects_standard_base64() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(bound_challenge.to_base64()), x""),
        check_auth_for(id, bound_challenge),
    ).run_must_fail("challenge does not match the operation");
}

function test_auth_for_wrong_challenge() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(webauthn.base64url(x"00112233445566778899aabbccddeeff")), x""),
        check_auth_for(id, bound_challenge),
    ).run_must_fail("challenge does not match the operation");
}

function test_auth_for_no_challenge() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", "{\"type\":\"webauthn.get\"}", x""),
        check_auth_for(id, bound_challenge),
    ).run_must_fail("no challenge in client data");
}

function test_auth_for_no_auth_op() {
    rell.test.tx().op(
        check_auth_for(id, bound_challenge),
    ).run_must_fail("no gtxc.webauthn_authenticate operation before me in transaction");
}

function operation_challenge_for(expected_id: byte_array, nonce: integer) =
    (chain_context.blockchain_rid, "check_auth_for_operation", [expected_id.to_gtv(), nonce.to_gtv()]).hash();

function test_auth_for_operation_success() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(webauthn.base64url(operation_challenge_for(id, 1))), x""),
        check_auth_for_operation(id, 1),
    ).run();
}

function test_auth_for_operation_other_args() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(webauthn.base64url(operation_challenge_for(id, 1))), x""),
        check_auth_for_operation(id, 2),
    ).run_must_fail("challenge does not match the operation");
}

function test_one_assertion_does_not_cover_a_second_operation() {
    rell.test.tx().op(
        webauthn_authenticate(id, x"", client_data(webauthn.base64url(operation_challenge_for(id, 1))), x""),
        check_auth_for_operation(id, 1),
        check_auth_for_operation(id, 2),
    ).run_must_fail("challenge does not match the operation");
}

// The node computes the same value (WebAuthnBindChallengeTest: operation challenge matches the Rell library).
function test_operation_challenge_vector() {
    val brid = x"0101010101010101010101010101010101010101010101010101010101010101";
    assert_equals(
        (brid, "transfer", [x"aa".to_gtv(), (5).to_gtv(), "n1".to_gtv()]).hash(),
        x"e9929c568805e0c26b8cf7b771b1423b79e8a1c28d9d43d67e2512b359fa71d7",
    );
}

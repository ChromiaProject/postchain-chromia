module;

import lib.webauthn;

@mount("gtxc.webauthn_register")
operation webauthn_register(
    id: byte_array,
    attestation_object: byte_array,
    client_data_json: text,
    transports: list<text>,
) {}

@mount("gtxc.webauthn_authenticate")
operation webauthn_authenticate(
    id: byte_array,
    authenticator_data: byte_array,
    client_data_json: text,
    signature: byte_array,
) {}

operation check_register(expected_challenge: text, expected_id: byte_array, expected_transports: list<text>) {
    val credential_record = webauthn.require_register(expected_challenge);
    require(credential_record.id == expected_id, "wrong id");
    require(credential_record.transports == expected_transports, "wrong transports");
}

operation check_auth(expected_challenge: text, expected_id: byte_array) {
    val auth_data = webauthn.require_auth(expected_challenge);
    require(auth_data.id == expected_id, "wrong id");
}

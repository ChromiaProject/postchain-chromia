module;

import lib.webauthn;

@mount("gtxc.checksig_webauthn_authenticate")
operation checksig_webauthn_authenticate(
     authenticator_data: byte_array,
     client_data_json: text,
     alg: integer,
     public_key: byte_array,
     signature: byte_array,
) {}

operation check_auth(expected_challenge: text, expected_alg: integer, expected_public_key: byte_array) {
    val auth_data = webauthn.require_auth(expected_challenge);
    require(auth_data.alg == expected_alg, "wrong alg");
    require(auth_data.public_key == expected_public_key, "wrong public_key");
}

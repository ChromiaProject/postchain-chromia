@mount('webauthn')
module;

val auth_op_name = "gtxc.checksig_webauthn_authenticate";

struct auth_data {
     alg: integer;
     public_key: byte_array;
}

function require_auth(expected_challenge: text): auth_data {
    require(op_context.exists, "not in an operation");
    val auth_op = extract_auth_op();

    val client_data_json = text.from_gtv(auth_op.args[1]);
    val client_data = map<text, gtv>.from_gtv_pretty(gtv.from_json(client_data_json));
    val challenge = text.from_gtv(client_data["challenge"]);
    require(challenge == expected_challenge, "wrong challenge");

    return auth_data(integer.from_gtv(auth_op.args[2]), byte_array.from_gtv(auth_op.args[3]));
}

function extract_auth_op(): gtx_operation {
    val all_ops = op_context.get_all_operations();
    for (i in range(op_context.op_index - 1, -1, step = -1)) {
        if (all_ops[i].name == auth_op_name) return all_ops[i];
    }
    require(false,"no %s operation before me in transaction".format(auth_op_name));
    return op_context.get_current_operation(); // unreachable
}

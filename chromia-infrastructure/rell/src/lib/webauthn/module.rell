module;

val register_op_name = "gtxc.webauthn_register";
val auth_op_name = "gtxc.webauthn_authenticate";

struct credential_record {
    id: byte_array;
    transports: list<text>;
}

function require_register(): credential_record {
    require(op_context.exists, "not in an operation");
    val register_op = extract_op(register_op_name);

    return credential_record(
        id = byte_array.from_gtv(register_op.args[0]),
        transports = list<text>.from_gtv(register_op.args[3]),
    );
}

struct auth_data {
    id: byte_array;
}

function require_auth(): auth_data {
    require(op_context.exists, "not in an operation");
    val auth_op = extract_op(auth_op_name);

    return auth_data(id = byte_array.from_gtv(auth_op.args[0]));
}

/**
 * Like require_auth(), and also requires that the challenge the authenticator signed is expected_challenge.
 *
 * The node only checks that a challenge is 16-64 bytes and not used before, not what it was derived from, so
 * without this check an unused assertion can be put in front of any operation.
 */
function require_auth_for(expected_challenge: byte_array): auth_data {
    require(op_context.exists, "not in an operation");
    val auth_op = extract_op(auth_op_name);
    val client_data = map<text, gtv>.from_gtv_pretty(gtv.from_json(text.from_gtv(auth_op.args[2])));
    require("challenge" in client_data, "no challenge in client data");
    val challenge = text.from_gtv(client_data["challenge"]).replace("=", "");
    require(challenge == base64url(expected_challenge), "challenge does not match the operation");

    return auth_data(id = byte_array.from_gtv(auth_op.args[0]));
}

/**
 * The challenge for the current operation: the hash of (blockchain RID, operation name, operation arguments).
 * The client computes the same GTV hash of [blockchain_rid, name, args] (postchain-client: gtvHash) and passes it
 * as the WebAuthn challenge. Give the operation a nonce argument so that the same call can be made twice.
 */
function operation_challenge(): byte_array {
    require(op_context.exists, "not in an operation");
    val op = op_context.get_current_operation();
    return (chain_context.blockchain_rid, op.name, op.args).hash();
}

/** require_auth_for(operation_challenge()) */
function require_auth_for_operation(): auth_data = require_auth_for(operation_challenge());

/** Base64url without padding, as in clientDataJSON.challenge. */
function base64url(b: byte_array): text = b.to_base64().replace("+", "-").replace("/", "_").replace("=", "");

function extract_webauthn_register_args() {
    val args = extract_op(register_op_name).args;
    val id = byte_array.from_gtv(args[0]);
    val attestation_object = byte_array.from_gtv(args[1]);
    val client_data = map<text, gtv>.from_gtv_pretty(gtv.from_json(text.from_gtv(args[2])));
    val transports = list<text>.from_gtv(args[3]);
    return (
        id = id,
        attestation_object = attestation_object,
        client_data = client_data,
        transports = transports,
    );
}

function extract_webauthn_auth_args() {
    val args = extract_op(auth_op_name).args;
    val id = byte_array.from_gtv(args[0]);
    val authenticator_data = byte_array.from_gtv(args[1]);
    val client_data = map<text, gtv>.from_gtv_pretty(gtv.from_json(text.from_gtv(args[2])));
    val signature = byte_array.from_gtv(args[3]);
    return (
        id = id,
        authenticator_data = authenticator_data,
        client_data = client_data,
        signature = signature,
    );
}

function extract_op(name): gtx_operation {
    val all_ops = op_context.get_all_operations();
    for (i in range(op_context.op_index - 1, -1, step = -1)) {
        if (all_ops[i].name == name) return all_ops[i];
    }
    require(false,"no %s operation before me in transaction".format(name));
    return op_context.get_current_operation(); // unreachable
}


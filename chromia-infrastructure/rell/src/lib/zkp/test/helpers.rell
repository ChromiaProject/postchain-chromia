module;

import ^^.*;

operation zkp_plonk_verify(verification_key: text, proof: gtv, public_signals: list<big_integer>) {}

operation verify_plonk_proof(
    verification_key: text,
    public_signals: list<big_integer>
) {
    check_plonk_proof(verification_key, public_signals);
}

operation verify_plonk_proof_with_public_signal_one(
    verification_key: text
) {
    val signals = extract_signals_from_preceeding_proof_op(verification_key);
    require(signals[0] == 1L);
}


@test module;

import ^^.*;
import ^.helpers.*;

function test_hc() {
    rell.test.tx().op(
        submit_compute_request_op("one", "nn", "ABCD".to_gtv())
    ).run();
    rell.test.tx().op(
        submit_compute_request_op("two", "nn", "1234".to_gtv())
    ).run();
    assert_equals(
        get_requests(),
        [
            compute_request(id = "one", type = "nn", input = "ABCD".to_gtv()),
            compute_request(id = "two", type = "nn", input = "1234".to_gtv()),
        ]
    );
    assert_equals(fetch_compute_result("one"), (result=null, error=null));

    rell.test.tx().op(
        request_taken_op("one")
    ).run();
    assert_equals(
        get_requests(),
        [
            compute_request(id = "two", type = "nn", input = "1234".to_gtv()),
        ]
    );
    rell.test.tx().op(
        request_taken_op("one")
    ).nop().run_must_fail("Computation <one> must be NEW, but is TAKEN");
    assert_equals(fetch_compute_result("one"), (result=null, error=null));

    rell.test.tx().op(
        response_op("two", "nn", "0000".to_gtv())
    ).run_must_fail("Computation <two> must be TAKEN, but is NEW");

    rell.test.tx().op(
        response_op("one", "xx", "00".to_gtv())
    ).run_must_fail("Computation <one> must have type <nn>");

    rell.test.tx().op(
        response_op("one", "nn", "AABBCCDD".to_gtv())
    ).run();
    assert_equals(fetch_compute_result("one"), (result="AABBCCDD".to_gtv(), error=null));

    rell.test.tx().op(
        response_op("one", "nn", "00".to_gtv())
    ).run_must_fail("Computation <one> must be TAKEN, but is COMPUTED");

    rell.test.tx().op(
        request_taken_op("two")
    ).run();
    assert_equals(get_requests(), list<compute_request>());
    assert_equals(fetch_compute_result("two"), (result=null, error=null));

    rell.test.tx().op(
        failure_op("two", "nn", "Some error")
    ).run();
    assert_equals(fetch_compute_result("two"), (result=null, error="Some error"));
}

function test_computation_not_found() {
    assert_fails("No computation with id <bogus>", fetch_compute_result("bogus", *));

    rell.test.tx().op(
        request_taken_op("bogus")
    ).run_must_fail("No computation with id <bogus>");

    rell.test.tx().op(
        response_op("bogus", "nn", "00".to_gtv())
    ).run_must_fail("No computation with id <bogus>");
}

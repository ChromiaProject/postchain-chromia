module;

import ^^.*;

operation submit_compute_request_op(id: text, type: text, input: gtv) {
    submit_compute_request(id, type, input);
}

operation request_taken_op(id: text, processed_by: byte_array) {
    request_taken_impl(id, processed_by);
}

operation response_op(id: text, type: text, output: gtv) {
    response_impl(id, type, output);
}

operation failure_op(id: text, type: text, error: text) {
    failure_impl(id, type, error);
}

object result {
    mutable id: text = "";
    mutable error: text = "";
}

@extend(on_compute_result)
function (id: text, compute_result) {
    result.id = id;
    result.error = compute_result.error ?: "";
}

module;

import ^^.*;

operation submit_compute_request_op(id: text, type: text, input: byte_array) {
    submit_compute_request(id, type, input);
}

operation request_taken_op(id: text) {
    request_taken_impl(id);
}

operation response_op(id: text, type: text, output: byte_array) {
    response_impl(id, type, output);
}

operation failure_op(id: text, type: text, error: text) {
    failure_impl(id, type, error);
}

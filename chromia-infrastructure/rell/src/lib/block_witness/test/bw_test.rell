@test module;

import bw: ^^;

val subject1 = x"032E5A2B490B4093429B875E83FDA7ED499ED7E001782F1D6C6AD33AC9EF44FEAA";
val data1 = x"F5276652B782E07BB23B8493B4674A9E49C58F434F784736A8CF7557C0B3410E12333AFFD710B5667FC3F1630FBDC467DC04F6379CC639D7ADC81293E25F2563";

val subject2 = x"03C07072E1AF1F5488FCCB2CA4DE3DC6BB66BAB3CD6FA9D22D1FA0455BE3B5CFF7";
val data2 = x"0228F64701F10BBE4A503DAD15096AA4767E685452230F472454D5228875140C7C74DE10A9530B041EDA563C68E0C0747D566A81BE7D2A21DBF4D55F77F00F78";

val subject3 = x"02FFC9A47B1D15C693F2E224C34E1DCF1AA4E4884B6D68683E2FB881CEFB29C312";
val data3 = x"6F9EA327A901DAA7D022EC679F38C043F8D153827E8599B679CED78FDA92DADC4FFF354F8B6F3B5FCC0ED49FCBA22579EA4846D8D979FA16D547C14A710F15B3";

val witness_data = x"";

@test function encode() {
    val encoded = bw.encode(
        [bw.signature(subjectID=subject1, data=data1), bw.signature(subjectID=subject2, data=data2), bw.signature(subjectID=subject3, data=data3)]
    );
    assert_equals(encoded, witness_data);
}

@test function decode() {
    val decoded = bw.decode(witness_data);
    assert_equals(
        decoded,
        [bw.signature(subjectID=subject1, data=data1), bw.signature(subjectID=subject2, data=data2), bw.signature(subjectID=subject3, data=data3)]
    );
}

query get_provider (pubkey) = provider @ { pubkey };

query get_provider_data (pubkey) {
    return provider_state @ {
        provider @ { pubkey }
    } (
        pubkey = .provider.pubkey,
        name = .name,
        active = .active
    );
}

query get_node (pubkey) = node @ { pubkey };

query get_node_data (pubkey) {
    return node @ {
        pubkey
    } (
        provider = .provider.pubkey,
        pubkey = .pubkey,
        active = .active,
        host = .host,
        port = .port,
        last_updated = .last_updated
    );
}

query get_blockchain (rid: byte_array) = blockchain @ { rid };

query get_added_blockchain_rid(tx_rid: byte_array) {
	return blockchain_added @ { transaction @ { tx_rid } }.blockchain.rid;
}

query enterprise_solution_version() = "0.1";


// queries not found in chromia0 repository, but used in tests in the pmc repository: postchain-mc/src/test/kotlin/net/postchain/mc/test/Chromia0Test.kt 
query get_all_providers() {
    return provider_state @* {} (
        pubkey = .provider.pubkey,
        name = .name,
        active = .active
    );
}

query get_nodes_by_provider(provider) {
    return node @* { provider } (
        .pubkey,
        .active,
        .host,
        .port,
        .last_updated
    );
}

query get_nodes_with_provider() {
    return (node, provider_state) @* { node.provider == provider_state.provider } (
        pubkey = .pubkey,
        node_active = node.active,
        host = .host,
        port = .port,
        last_updated = .last_updated,
        name = .name,
        provider_active = provider_state.active,
        provider = node.provider.pubkey
    );
}

query get_blockchain_signers(blockchain) {
    return blockchain_signer_node @* { blockchain } (
        .blockchain.rid,
        @sort .node.pubkey,
        .node.host,
        .node.port,
        .node.active,
        .node.last_updated
    );
}

query get_blockchain_replicas(blockchain) {
    return blockchain_replica_node @* { blockchain} (
        .blockchain.rid,
        @sort .node.pubkey,
        .node.host,
        .node.port,
        .node.active,
        .node.last_updated
    );
}

query get_blockchain_last_height(blockchain) = get_last_height(blockchain);


//queries used in the voting procedure for configuration updates:
query get_proposals_since (since: rowid) {
  return proposal @* {  .rowid > since } (.rowid, .proposal_type) limit 10;
}

query get_proposal (rowid: rowid) {
  return proposal @{  .rowid == rowid };
}

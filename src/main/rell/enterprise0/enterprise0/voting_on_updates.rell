entity voter_set {
    key name;
    mutable threshold: integer = 0;
	// special values for threshold:
	// 	0: supermajority of voters, specifically  `n - (n - 1) / 3` (which is usually around 67%)
	// -1: simple majority
	// positive number: that many voters
}

// Who is allowed to change a voter set?
// If not defined, it is the voter set itself
entity voter_set_governance {
	key voter_set;
	index governor: voter_set;
}

entity voter_set_member {
    key voter_set, provider;
}
/* Governance semantics:
 *
 * Anybody can create a new voter_set directly, but it consumes an action point.
 * voter_set can be updated. if voter_set_goverance is defined, it will control voter set, otherwise, it is the voter set itself
 * */
 operation create_voter_set(me: provider, name, threshold: integer, initials: list<provider>?, govenor: voter_set?) {
 	require_provider_auth_with_rl(me);
 	val vs = create voter_set(name, threshold);
 	if (exists(govenor)) {
 		create voter_set_governance(voter_set=vs, governor=govenor);
 	}
 	 if (exists(initials)) {
 		for (prov in initials) {
 			create voter_set_member(voter_set=vs, prov);	
 	 	}
 	}
 }

 enum proposal_type {
   conf,
   bc,
   register_provider,
   provider_state,
   bc_stop
   // and a lot more
}

entity proposal {
  index timestamp, proposal_type;
  proposed_by: provider;
  index voter_set; // voter set is determined at the time proposal is created
}


entity vote {
    key proposal, provider;
	ok: boolean; //here we see if the signer voted yes or no
}

 
//Proposed configuration changes are put here while waiting for enough positive votes.
entity pending_conf {
    key proposal;
    blockchain;
	height: integer;
    data: byte_array;
}

//Proposed stops of bcs are put here while waiting for enough positive votes.
entity pending_stop_blockchain {
    key proposal;
    blockchain;
	remove_replicas: boolean;
    }

//Proposed providers are put here while waiting for enough positive system provider votes.
entity pending_provider {
	key proposal;
	pubkey;
	system: boolean;
	tier: integer;
	cluster;
}

//Proposed bc:s are put here while waiting for enough positive votes. One row per node in init list?
entity pending_blockchain {
	key proposal;
	data: byte_array;
	container;
}

//Proposed enabling/disabling of providers are put here while waiting for enough positive votes.
entity pending_provider_state {
	key proposal;
	provider;
	active: boolean;
}

//Proposed changes of blockchain signers are put here while waiting for enough positive votes. Signers can be added (add = true) or removed (add = false).
entity pending_update_blockchain_signer {
	key proposal, signer: node;
	blockchain;
	add: boolean;
}

operation propose_blockchain( me: provider, config_data: byte_array, container) {
	print("propose bc, chain0 brid:");
	print(chain_context.blockchain_rid);
	require_provider_auth_with_rl(me);
	if (empty(pending_blockchain @* {.data == config_data } limit 1)) {
		val prop = create proposal(op_context.last_block_time, proposal_type.bc, me, container.configurator);
		create pending_blockchain(prop, config_data, container);
		internal_vote( me, prop, true);
	}
}


//Pubkey used for authorization. Who can propse configuration updates? Container configurators
//TODO: make voter_set variable. 
operation propose_configuration (blockchain, provider, config_data: byte_array, height: integer) {
	require_provider_auth_with_rl(provider);
	require_container_configurator(blockchain, provider);
	require(get_last_height(blockchain) < height);
	require(empty(blockchain_configuration @? { blockchain, .height >= height } limit 1));
	require(empty(pending_conf @? { blockchain, .height >= height } limit 1));
	//If already proposed, do not add again.
	if (empty(pending_conf @* {blockchain, height, .data == config_data } limit 1)) {
		val prop = create proposal(op_context.last_block_time, proposal_type.conf, provider, voter_set @ {"SYSTEM_P"});
		create pending_conf(prop,
			blockchain,		
			height,
			data = config_data
		);
		internal_vote(provider, prop, true);
	}
}


//Who can stop bcs? Container configurators
//TODO: make voter_set variable. 
operation propose_stop_blockchain(me: provider, blockchain, remove_replicas: boolean) {
	require_provider_auth_with_rl (me);
	require_container_configurator(blockchain, me);
	//If already proposed, do not add again.
	if (empty(pending_stop_blockchain @* {remove_replicas, blockchain } limit 1)) {
		val prop = create proposal(op_context.last_block_time, proposal_type.bc_stop, me, voter_set @ {"SYSTEM_P"});
		create pending_stop_blockchain(prop, blockchain, remove_replicas);
		internal_vote(me, prop, true);
	}
}



//Only system providers can add new providers => voter_set = SYSTEM_P
//When proposing provider, also (optinally?) say which cluster it should be added to.
operation propose_provider(me: provider, pubkey, system: boolean, tier: integer, cluster) {
	require_provider_auth_with_rl(me);
	//Provider with tier > 0 can invite a provider of tier 0.
	//val my_tier = provider_state @ {me} .tier;
	//require(my_tier > tier);
	//If already proposed, do not add again.
	if (empty(pending_provider @* {pubkey } limit 1)) {
		val system_voter_set = voter_set @ {"SYSTEM_P"};
		val prop = create proposal(op_context.last_block_time, proposal_type.register_provider, me, system_voter_set);
		create pending_provider(prop, pubkey, system, tier, cluster);
		internal_vote(me, prop, true);
	}
}

operation propose_enable_provider(me: provider, other_prov: provider) {
	require_provider_auth_with_rl(me);
	//If proposal already exist, do not add again.
	if (empty(pending_provider_state @* { .provider == other_prov, .active == true } limit 1)) {
		val system_voter_set = voter_set @ {"SYSTEM_P"};
		val prop = create proposal(op_context.last_block_time, proposal_type.provider_state, me, system_voter_set);
		create pending_provider_state(prop, other_prov, .active = true);
		internal_vote( me, prop, true);
	}
}

operation propose_disable_provider(me: provider, other_prov: provider) {
	require_provider_auth_with_rl(me);
	if (empty(pending_provider_state @* { .provider == other_prov, .active == false } limit 1)) {
		val system_voter_set = voter_set @ {"SYSTEM_P"};
		val prop = create proposal(op_context.last_block_time, proposal_type.provider_state, me, system_voter_set);
		create pending_provider_state(prop, other_prov, .active = false);
		internal_vote( me, prop, true);
	}
}

//NB: check authority before calling this function
function internal_vote (provider, prop: proposal, ok: boolean) {
	create vote(prop, provider, ok);
	print("vote added");
	apply_voting_result(prop);
}

//Pubkey used for authorization
operation make_vote(provider, prop: proposal, ok: boolean) {
	require_provider_auth_with_rl(provider);
	require(not(empty(voter_set_member @* {prop.voter_set, provider})));
	print("vote authorization OK");
	require(empty(vote @? {prop, provider})); //only one vote per pubkey.
	internal_vote( provider, prop, ok);
}

function apply_voting_result (prop: proposal) {
	print("consensus?");
	if (consensus_achieved(prop)) {
		print("approval achieved");
		when (prop.proposal_type) {
	 		conf              -> apply_conf(prop);
	 		bc                -> apply_bc(prop);
			register_provider -> apply_register_provider(prop);
			provider_state    -> apply_provider_state(prop);
			bc_stop			  -> apply_stop_blockchain(prop);
	}
		val prop_id = vote @* {.proposal == prop} (.rowid);
		delete vote @* {.proposal == prop};	
		delete proposal @ {.rowid == prop.rowid}; 
	} else if (proposal_rejected(prop)) {
		print("proposal has been rejected");
		when (prop.proposal_type) {
	 		conf              -> delete pending_conf @ { prop };
	 		bc                -> delete pending_blockchain @ { prop };
			register_provider -> delete pending_provider @ { prop };
			provider_state    -> delete pending_provider_state @ { prop };
			bc_stop			  -> delete pending_stop_blockchain @ { prop };
	}
		val prop_id = vote @* {.proposal == prop} (.rowid);
		delete vote @* {.proposal == prop};	
		delete proposal @ {.rowid == prop.rowid};
	} else {
		
		print("no, not yet");
	}
}

//For both enabling and disabling of providers: Add `tier` and `system`
// updates (not just `active`)? No it is done when registering the provider.
function apply_provider_state(proposal) {
	val pps = pending_provider_state @ {proposal}; 
	update provider_state @ { pps.provider } ( .active = pps.active );
	if (pps.active == false) {
		update node @* { pps.provider } ( .active = false );
		for (cl in cluster_provider @* { .provider == pps.provider } (.cluster)) {
			for (n in node @* { pps.provider }) {
				delete cluster_node @* { n };	
			}
			update_configuration_signers(cl);
		}
		node_list.last_update = op_context.last_block_time;
		//remove disabled provider from voter_set_member table
		delete voter_set_member @* { .provider == pps.provider};
		//TODO: Delete all replicas of the provider?
		delete blockchain_replica_node @* { .node.provider == pps.provider };
	} else { //enable
		//If enabled provider is a system provider, update SYSTEM_P voter set
		if (provider_state @ { pps.provider }.system) {
			//val system_voter_set = voter_set @ {"SYSTEM_P"};
			create voter_set_member(voter_set @ {"SYSTEM_P"}, pps.provider);
		}
	}
	delete pending_provider_state @ { proposal };
}

function apply_conf(proposal) {
	val pc = pending_conf @ {proposal};
	require(get_last_height(pc.blockchain) < pc.height);
	require(empty(blockchain_configuration @? { pc.blockchain, .height > pc.height } limit 1));
	create blockchain_configuration(
		pc.blockchain,
		pc.height,
		data = pc.data
	);
	delete pending_conf @* { proposal };
}

//Initial signers of new bc are the ones in cluster_node table.
function apply_bc(proposal) {
	val bc = pending_blockchain @ {proposal};
	val config = map<text, gtv>.from_gtv(gtv.from_bytes(bc.data));
	val blockchain_rid = config.hash();
	val blockchain = create blockchain ( blockchain_rid );
	print("Added blockchain", blockchain_rid);
	create blockchain_configuration (blockchain, 0, bc.data);
	val signers = cluster_node @* { bc.container.cluster } (@sort .node.pubkey);
	// do not write new configuration when size is 0 since it's impossible to recover
	// from that.
	require(signers.size() > 0);
	create blockchain_configuration_signers(blockchain, 0, signers.to_gtv().to_bytes());
	create blockchain_added (blockchain, op_context.transaction);
	create container_blockchain(bc.container, blockchain);
	delete pending_blockchain @* { proposal };
}

function apply_register_provider(proposal) {
	val pp = pending_provider @ { proposal };
	add_pubkey_as_provider(pp.pubkey, pp.system, pp.tier, pp.cluster);
	delete pending_provider @ { proposal };
}


//TODO: How to set signers empty?
function apply_stop_blockchain(proposal) {
	val bc_to_stop = pending_stop_blockchain @ { proposal };
	//val h = get_last_height(bc_to_stop);
	//val signers = list<pubkey>();
	//create blockchain_configuration_signers ( blockchain = bc_to_stop, height = h, signers.to_gtv().to_bytes() );
	//delete blockchain_configuration_signers @ { .blockchain == bc_to_stop.blockchain};
	if (bc_to_stop.remove_replicas) {
		delete blockchain_replica_node @* { bc_to_stop.blockchain };
	} 	
	delete pending_stop_blockchain @ { proposal };
}


function max_votes() { return provider_state @* { .active == true } (@sum 1) limit 1;}
function positive_votes(proposal) { return vote @* {proposal, .ok == true }; }
function negative_votes(proposal) { return vote @* {proposal, .ok == false }; }


function consensus_achieved (proposal) {
	if (exists(positive_votes(proposal))) {
		val nof_votes = vote @* { .proposal == proposal, .ok == true} ( @sum 1 );
		print("positive votes:", nof_votes);
		print("max votes:", max_votes());
		print("needed votes:", max_votes()[0]/2+1);
		return ((nof_votes[0] > max_votes()[0]/2));
	}
	print("No positive votes");
	return false; 
}

function proposal_rejected (proposal) {
	if (exists(negative_votes(proposal))) {		
		val nof_votes = vote @* { .proposal == proposal, .ok == false} ( @sum 1 );
		print("negative votes:", nof_votes);
		print("max votes:", max_votes());
		print("needed votes:", max_votes()[0]/2+1);
		return ((nof_votes[0] > max_votes()[0]/2));
	}
	print("No negative votes");
	return false;	
}

    <nodes>
        <config add-signers="false">#</config>
    </nodes>
    <chains>
        <chain name="anchoring_chain_cluster" iid="0">
            <config height="0" add-dependencies="false">
                <gtv path="config_consensus_strategy"><string>HEADER_HASH</string></gtv>
                <gtv path="blockstrategy/maxblocktime"><int>2000</int></gtv>
                <gtv path="gtx/modules">
                    <array>
                        <string>net.postchain.d1.anchoring.cluster.ClusterAnchoringGTXModule</string>
                        <string>net.postchain.d1.icmf.IcmfSenderGTXModule</string>
                    </array>
                </gtv>
                <app module="anchoring_chain_cluster"/>
            </config>
        </chain>
    </chains>
</run>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<run wipe-db="false">
    <nodes>
        <config add-signers="false">#</config>
    </nodes>
    <chains>
        <chain name="anchoring_chain_system" iid="0">
            <config height="0" add-dependencies="false">
                <gtv path="config_consensus_strategy"><string>HEADER_HASH</string></gtv>
                <gtv path="blockstrategy/maxblocktime"><int>2000</int></gtv>
                <gtv path="gtx/modules">
                    <array>
                        <string>net.postchain.d1.anchoring.system.SystemAnchoringGTXModule</string>
                        <string>net.postchain.d1.icmf.IcmfSenderGTXModule</string>
                    </array>
                </gtv>
                <app module="anchoring_chain_system">
                    <args module="anchoring_chain_common">
                        <arg key="enable_pcu"><int>0</int></arg>
                    </args>
                </app>
            </config>
        </chain>
    </chains>
</run>

module;

import iccf;

entity book { key name; }

// These cities are received from city chain via ICMF
entity icmf_city { key name; }

// These cities are received from city chain via ICCF
entity iccf_city { key name; }

operation add_book (name) { create book (name); }

query get_books () { return book @* {} ( .name ); }

operation __icmf_message(sender: byte_array, topic: text, body: gtv) {
    create icmf_city(text.from_gtv(body));
}

operation iccf_transfer(transaction: gtx_transaction) {
    val tx_args = iccf.extract_operation_args(transaction, "add_city");
    if (tx_args.size() == 1) create iccf_city(text.from_gtv(tx_args[0]));
}

query get_icmf_cities () { return icmf_city @* {} ( .name ); }

query get_iccf_cities () { return iccf_city @* {} ( .name ); }



//queries used in the voting procedure for configuration updates:
query get_proposals_since(since: rowid) {
  return proposal @* { .rowid >= since } (.rowid, .proposal_type) limit 10;
}

query get_proposal (rowid) {
  return proposal @ { rowid }
  (
        proposed_by = .proposed_by.pubkey,
        timestamp = .timestamp,
        proposal_type = .proposal_type,
        rowid = .rowid
    );
}

query get_blockchain_proposal(rowid): (data:byte_array, container:text) {
	return pending_blockchain @ { proposal @ { rowid } } ( data = .data, container = .container.name );
}

query get_configuration_proposal(rowid): (height:integer, current_conf:struct<blockchain_configuration>, new_conf:byte_array, proposed_conf:struct<pending_conf>)? {
	
	val proposal = proposal @? { rowid };
	if (proposal == null) return null;
	val config = pending_conf @? { proposal };
	if (config == null) return null;
	val current = (blockchain_configuration @ { config.blockchain , .height > 0 }
     (@omit @sort_desc .height, bc=blockchain_configuration) limit 1).bc;
	
	
	return (
		height = config.height,
		current_conf = current.to_struct(),
		new_conf = config.data,
		proposed_conf = config.to_struct()
		
	);
}

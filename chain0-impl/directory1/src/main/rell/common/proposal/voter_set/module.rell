module;

import ^.*;
import ^^.model.*;

entity pending_voter_set_update {
    key proposal, voter_set;
}

entity voter_set_update_threshold {
    key pending_voter_set_update;
    threshold: integer;
}

entity voter_set_update_governor {
    key pending_voter_set_update;
    governor: voter_set;
}

entity voter_set_update_new_member {
    key pending_voter_set_update;
    provider;
}

entity voter_set_update_remove_member {
    key pending_voter_set_update;
    provider;
}

function apply_voter_set_update(proposal) {
	val vsp = pending_voter_set_update @ { proposal };
    val threshold = voter_set_update_threshold @? { vsp }.threshold;
	if (threshold != null) vsp.voter_set.threshold = threshold;
    val governor = voter_set_update_governor @? { vsp }.governor;
	if (governor != null) update voter_set_governance @ { .voter_set == vsp.voter_set } (.governor = governor);
    val new_member = voter_set_update_new_member @? { vsp }.provider;
	if (new_member != null) create voter_set_member(vsp.voter_set, new_member);
    val remove_member = voter_set_update_remove_member @? { vsp }.provider;
	if (remove_member != null) delete voter_set_member @ { vsp.voter_set, remove_member };
}

function delete_pending_voter_set_update(proposal) {
    val p = pending_voter_set_update @ { proposal };
    delete voter_set_update_threshold @? { p };
    delete voter_set_update_governor  @? { p };
    delete voter_set_update_new_member  @? { p };
    delete voter_set_update_remove_member  @? { p };
    delete p;
}

//Who can change voter set governor? Voter set governor.
operation propose_voter_set_governor(me: provider, voter_set, new_governor: voter_set) {
	//check that provider authority and that it is in cluster's governor voter set
	require_provider_auth_with_rl(me);
	require_voter_set_governor(voter_set, me);
	val prop = create proposal(
	    op_context.last_block_time,
	    proposal_type.voter_set_governor,
	    me,
	    voter_set_governance @ { voter_set }.governor
	);
	create pending_voter_set_governor(prop, voter_set, .governor = new_governor);
	internal_vote(me, prop, true);
}

operation propose_update_voter_set(my_pubkey: pubkey, voter_set_name: name, new_threshold: integer?, new_governor: name?, new_member: pubkey?, remove_member: pubkey?) {
	val provider = require_is_provider_with_rl(my_pubkey);
	val voter_set = require_voter_set(voter_set_name);

	val prop = create proposal(
		op_context.last_block_time,
		proposal_type.voter_set_update,
		provider,
		voter_set_governance @ { voter_set }.governor
	);
	val update_prop = create pending_voter_set_update(prop, voter_set);
	if (new_threshold != null) { 
        require(new_threshold >= -1 and new_threshold <= (voter_set_member @* { voter_set }).size(), 
		"Invalid threshold level, muste be in range [-1, voter_set.size()]");
        create voter_set_update_threshold(update_prop, new_threshold);
    }
	if (new_governor != null) { 
        val g = require_voter_set(new_governor);
        create voter_set_update_governor(update_prop, g);
    }
	if (new_member != null) { 
        val p = require_provider(new_member);
        create voter_set_update_new_member(update_prop, p);
    }
    if (remove_member != null) { 
        val p = require_provider(remove_member);
        create voter_set_update_remove_member(update_prop, p);
    }
	internal_vote(provider, prop, true);
}


// Who can change cluster deployer? Cluster governor.
operation propose_cluster_deployer(my_pubkey: pubkey, cluster_name: text, new_deployer: name) {
	val me = require_provider(my_pubkey);
	//check that provider authority and that it is in cluster's governor voter set
	require_provider_auth_with_rl(me);
	val cluster = require_cluster(cluster_name);
	require_cluster_governor(cluster, me);
	val prop = create proposal(op_context.last_block_time, proposal_type.cluster_deployer, me, cluster.governance);
	val voter_set = require(voter_set @? { new_deployer });
	create pending_cluster_deployer(prop, cluster, voter_set);
	internal_vote(me, prop, true);
}

operation propose_remove_cluster(my_pubkey: pubkey, name) {
    val me = require_provider(my_pubkey);
    require_provider_auth_with_rl(me);
    val c = require(cluster @? { name }, "Unknown cluster %s".format(name));
    require_cluster_governor(c, me);
    require_cluster_available_for_removal(c);

    val prop = create proposal(op_context.last_block_time, proposal_type.cluster_remove, me, c.governance);
    create pending_remove_cluster(prop, c);
    internal_vote(me, prop, true);
}

// Who can update cluster limits? Cluster governance voter set.
operation propose_cluster_limits(
    my_pubkey: pubkey,
    cluster_name: text,
    max_containers: integer,
    default_container_cpu: integer,
    default_container_ram: integer,
    default_container_storage: integer
) {
    _propose_cluster_limits_internal(
        my_pubkey,
        cluster_name,
        max_containers,
        default_container_cpu,
        default_container_ram,
        default_container_storage
    );
}

// The operation is mostly needed to make rell-maven-plugin generate code for enum `cluster_resource_limit_type`
operation propose_cluster_limit(my_pubkey: pubkey, cluster_name: text, type: cluster_resource_limit_type, value: integer) {
    val limits_map = _get_current_cluster_resource_limits(cluster_name);
    limits_map[type] = value;

    _propose_cluster_limits_internal(
        my_pubkey,
        cluster_name,
        limits_map[cluster_resource_limit_type.max_containers],
        limits_map[cluster_resource_limit_type.default_container_cpu],
        limits_map[cluster_resource_limit_type.default_container_ram],
        limits_map[cluster_resource_limit_type.default_container_storage]
    );
}

function _propose_cluster_limits_internal(
    my_pubkey: pubkey,
    cluster_name: text,
    max_containers: integer,
    default_container_cpu: integer,
    default_container_ram: integer,
    default_container_storage: integer
) {
    val me = require_provider(my_pubkey);
	//check that provider authority and that it is a cluster governor
	require_provider_auth_with_rl(me);
	val cluster = require_cluster(cluster_name);
	require_cluster_governor(cluster, me);
	val prop = create proposal(op_context.last_block_time, proposal_type.cluster_limits, me, cluster.governance);
	create pending_cluster_limits(prop, cluster, max_containers, default_container_cpu, default_container_ram, default_container_storage);
	internal_vote(me, prop, true);
}

function _get_current_cluster_resource_limits(cluster_name: text): map<cluster_resource_limit_type, integer> {
    var limits_map = map<cluster_resource_limit_type, integer>();
    val cur_limits_list = cluster_resource_limit @* { .cluster.name == cluster_name };
    for (l in cur_limits_list) {
        limits_map[l.cluster_resource_limit_type] = l.value;
    }
    return limits_map;
}

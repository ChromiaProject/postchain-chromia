@test module;

import ^^.*;
import ^^.test.ops.*;
import ^^.util.*;
import ^^^.container.container_op.*;

function setup() {
	rell.test.tx().op(
	    initialize_test_module(rell.test.pubkeys.alice)
	).run();
}

function test_add_node_to_cluster() {
    setup();

    val system_cluster = system_cluster();
    val alice = provider @ { rell.test.pubkeys.alice };

    // asserting node added
    assert_equals(
        cluster_node @ { system_cluster } .node,
        node @ { } limit 1
    );

    // must fail
    rell.test.tx()
        .op(
            create_test_node(alice, rell.test.pubkeys.bob, system_cluster)
        )
        .sign(rell.test.keypairs.alice)
        .run_must_fail();
}

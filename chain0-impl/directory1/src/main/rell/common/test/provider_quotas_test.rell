@test module;

import ^.ops.*;
import ^.setup.*;
import ^^^.cluster.*;
import ^^^.cluster.cluster_op.*;
import ^^^.container.container_op.*;
import ^^^.container.container_proposal.*;
import ^.util.constants.*;

// Cluster

function test__create_cluster__when__max_clusters_is_default() {
    setup_module();

    rell.test.tx().op(
        create_cluster(initial_provider.pub, "cluster1",  voter_sets.system_p, list<pubkey>()),
        create_cluster(initial_provider.pub, "cluster2",  voter_sets.system_p, list<pubkey>())
    ).sign(initial_provider).run();
}

function test__create_cluster__when__max_clusters_is_0() {
    setup_module(provider_quota_max_clusters = 0);

    rell.test.tx().op(
        create_cluster(initial_provider.pub, "cluster1",  voter_sets.system_p, list<pubkey>()),
        create_cluster(initial_provider.pub, "cluster2",  voter_sets.system_p, list<pubkey>())
    ).sign(initial_provider).run();
}

function test__create_cluster__when__max_clusters_is_limited() {
    setup_module(provider_quota_max_clusters = 2); // system_cluster + two clusters

    rell.test.tx().op(
        create_cluster(initial_provider.pub, "cluster1",  voter_sets.system_p, list<pubkey>())
    ).sign(initial_provider).run();

    rell.test.tx().op(
        create_cluster(initial_provider.pub, "cluster2",  voter_sets.system_p, list<pubkey>())
    ).sign(initial_provider).run_must_fail();
}


// Container / create_

function test__create_container__when__max_containers_is_default() {
    setup_module();

    rell.test.tx().op(
        create_container(initial_provider.pub, "container1",  clusters.system, 0, list<pubkey>()),
        create_container(initial_provider.pub, "container2",  clusters.system, 0, list<pubkey>())
    ).sign(initial_provider).run();
}

function test__create_container__when__max_containers_is_0() {
    setup_module(provider_quota_max_containers = 0);

    rell.test.tx().op(
        create_container(initial_provider.pub, "container1",  clusters.system, 0, list<pubkey>()),
        create_container(initial_provider.pub, "container2",  clusters.system, 0, list<pubkey>())
    ).sign(initial_provider).run();
}

function test__create_container__when__max_containers_is_limited() {
    setup_module(provider_quota_max_containers = 2); // system_container + two containers

    rell.test.tx().op(
        create_container(initial_provider.pub, "container1",  clusters.system, 0, list<pubkey>())
    ).sign(initial_provider).run();

    rell.test.tx().op(
        create_container(initial_provider.pub, "container2",  clusters.system, 0, list<pubkey>())
    ).sign(initial_provider).run_must_fail();
}


// Container / propose_

function test__propose_container__when__max_containers_is_default() {
    setup_module();

    rell.test.tx().op(
        propose_container(initial_provider.pub, clusters.system, "container1", voter_sets.system_p),
        propose_container(initial_provider.pub, clusters.system, "container2", voter_sets.system_p)
    ).sign(initial_provider).run();
}

function test__propose_container__when__max_containers_is_0() {
    setup_module(provider_quota_max_containers = 0);

    rell.test.tx().op(
        propose_container(initial_provider.pub, clusters.system, "container1", voter_sets.system_p),
        propose_container(initial_provider.pub, clusters.system, "container2", voter_sets.system_p)
    ).sign(initial_provider).run();
}

function test__propose_container__when__max_containers_is_limited() {
    setup_module(provider_quota_max_containers = 2); // system_container + two containers

    rell.test.tx().op(
        propose_container(initial_provider.pub, clusters.system, "container1", voter_sets.system_p)
    ).sign(initial_provider).run();

    rell.test.tx().op(
        propose_container(initial_provider.pub, clusters.system, "container2", voter_sets.system_p)
    ).sign(initial_provider).run_must_fail();
}


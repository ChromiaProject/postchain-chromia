@test module;

import ^^.*;
import ^.ops.*;

function test_replace_node() {
    val provider = rell.test.keypairs.alice;
    rell.test.tx().op(initialize_test_module(provider.pub, 100)).run();
    assert_not_null(node @? { initial_signer_pubkey });

    val node1 = rell.test.keypair(priv = initial_signer_privkey, pub = initial_signer_pubkey);
    val node2 = rell.test.keypairs.trudy;

    print(node @ {}.pubkey);
    rell.test.tx().op(
        replace_node(provider.pub, node1.pub, node2.pub, null, 123, null) 
    )
    .sign(provider)
    .sign(node1)
    .sign(node2)
    .run();

    assert_null(node @? { initial_signer_pubkey });
    val new_node = node @? { node2.pub };
    assert_not_null(new_node);
    assert_equals(new_node.host, "localhost"); // From initialize_test_module
    assert_equals(new_node.port, 123);
}

module;

import ^^.*;

operation initialize_test_module(pubkey, majority_threshold:integer = 0) {
	initialize_module(pubkey, "localhost", 9870, 1000, majority_threshold);
}

operation create_test_provider(name, pubkey, tier:integer = 1) {
	val p = create provider(pubkey);
	create provider_state(p, name, active = true, system = true, tier);
	create provider_rl_state(p, points = 10000, last_update = 0);
}

operation create_test_node(provider, pubkey, cluster) {
	val c = list<text>();
	c.add(cluster.name);
	add_node_internal(provider, pubkey, "", 0, "", c);
}

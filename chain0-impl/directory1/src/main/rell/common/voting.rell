entity voter_set {
    key name;
    mutable threshold: integer = 0;
	// special values for threshold:
	// 	0: super-majority of voters, specifically  `n - (n - 1) / 3` (which is usually around 67%)
	// -1: simple majority
	// positive number: that many voters
}

// Who is allowed to change a voter set?
// If not defined, it is the voter set itself
entity voter_set_governance {
	key voter_set;
	mutable governor: voter_set;
}

entity voter_set_member {
    key voter_set, provider;
}

/**
 * Governance semantics:
 * Anybody can create a new voter_set directly, but it consumes an action point.
 * voter_set can be updated. if voter_set_goverance is defined, it will control voter set, otherwise, it is the voter set itself
 **/
operation create_voter_set(me: provider, name, threshold: integer, initials: list<provider>?, governor: voter_set?) {
    require_provider_auth_with_rl(me);
    val vs = create voter_set(name, threshold);
    if (exists(governor)) {
        create voter_set_governance(voter_set = vs, governor = governor);
    } else {
        create voter_set_governance(voter_set = vs, governor = vs);
    }
    if (exists(initials)) {
        for (prov in initials) {
            create voter_set_member(voter_set = vs, prov);
        }
    }
}

entity vote {
    key proposal, provider;
	vote: boolean; // yes | no
}

operation make_vote(provider, prop: proposal, vote: boolean) {
	require_provider_auth_with_rl(provider);
	require(not(empty(voter_set_member @* {prop.voter_set, provider})), "Provider is not a member of proposal voter_set");
	print("vote authorization: OK");
	require(empty(vote @? {prop, provider}), "Only one vote per pubkey is allowed");
	internal_vote(provider, prop, vote);
}

operation retract_vote(provider, prop: proposal) {
	require_provider_auth_with_rl(provider);
	require(not(empty(voter_set_member @* {prop.voter_set, provider})), "Provider is not a member of proposal voter_set");
	print("vote authorization: OK");

	if (exists(vote @? { prop, provider })) {
	    delete vote @* { prop, provider };
        print("vote for proposal retracted:", proposalStr(prop));
        log_proposal_voting(prop);
	} else {
	    print("not vote for proposal to retract:", proposalStr(prop));
	}
}

// NB: check authority before calling this function
function internal_vote(provider, prop: proposal, vote: boolean) {
	create vote(prop, provider, vote);
	print("vote added with value:", if (vote) "Yes" else "False");
	log_proposal_voting(prop);
	apply_voting_result(prop);
}

function log_proposal_voting(proposal) {
    val max = max_votes(proposal.voter_set);
    val needed = needed_votes(proposal.voter_set);
    val yes = positive_votes(proposal);
    val no = negative_votes(proposal);
    val msg = "max votes: %d, needed: %d, positive: %d, negative: %d".format(max, needed, yes, no);
    print(msg);
}

function max_votes(voter_set) {
    return (voter_set_member @* { voter_set } (@sum 1) limit 1)[0];
}

function positive_votes(proposal) {
    val votes = vote @? { proposal, .vote == true } (@sum 1);
    return if (exists(votes)) votes!! else 0;
}

function negative_votes(proposal) {
    val votes = vote @? { proposal, .vote == false } (@sum 1);
    return if (exists(votes)) votes!! else 0;
}

function needed_votes(voter_set) {
	val n = max_votes(voter_set);
	var needed_votes = voter_set.threshold;
	// two special cases (0 and -1):
	when (voter_set.threshold) {
		0  -> needed_votes = n-(n-1)/3;
	 	-1 -> needed_votes = n/2+1;
	}
	return needed_votes;
}

function is_consensus_achieved(proposal, needed: integer) {
    val positive = positive_votes(proposal);
	if (positive > 0) {
		return (positive >= needed);
	} else {
	    print("No positive votes");
	    return false;
	}
}

function is_proposal_rejected(proposal, needed: integer) {
    val negative = negative_votes(proposal);
	if (negative > 0) {
	    val max = max_votes(proposal.voter_set);
		return (negative > max - needed);
	} else {
	    print("No negative votes");
	    return false;
	}
}

module;

import .voting.*;
import .proposal.*;
import .queries.*;

query directory_solution_version() = "0.1";

// Adds the initial provider as a system provider along with voter sets and clusters needed to start
function initialize_module(initial_provider:pubkey, actions_per_day:integer, majority_threshold:integer = 0) {
	require(empty( provider @* {}));
	create_voter_set_internal("SYSTEM", 1);
	/** 
	 * System provider create a ‘system’ cluster which will include ‘system’ nodes and has a ‘system’ naked container 
	 * which will run the directory bc.
	 */
	val system_voter_set = create_voter_set_internal("SYSTEM_P", majority_threshold);
	val system_cluster = create cluster("system", governance=system_voter_set, deployer=system_voter_set, false);
	register_and_enable_provider(
		initial_provider, 
		is_system = true, 
		tier = 1, 
		cluster = system_cluster, 
		voter_set = system_voter_set, 
		enabled_by_default = true
	);
	create provider_quota(tier=0, provider_quota_type.max_actions_per_day, value = actions_per_day);
	create provider_quota(tier=1, provider_quota_type.max_actions_per_day, value = actions_per_day);

	create_container_with_resource_limits(
		"system",
		container_type.naked,
		cluster = system_cluster,
		voter_set = system_voter_set
	);
}
 
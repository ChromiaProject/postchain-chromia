/*
* A provider is a participant of the mainnet eco system
* - Add a replica node
* - Add a provider (Without priviliges)
* - Update their own information
* - Form a new voter set
* - Create a cluster
* - Vote on proposals concerning voter sets you belong to
*/
entity provider { 
	key pubkey; 
	mutable name: text = "";
	mutable active: boolean = false;
    mutable tier: integer = 0; 	// NEW. Tier defines how much stuff provider can add. 0 is lowest.
}

namespace roles {
    /* System provider can
    * - Add and remove signer nodes to clusters
    * - update the system cluster/voter set
    * - Add provider with any (non-system) privileges
    * - Propose removal of providers
    * - Update cluster configuration
    */
	entity system { key provider; }

	function has_system_access(provider) = provider.active and exists(system @? { provider });

	/* Can add signer nodes
	* - Be a part of a cluster
	*/
	entity node { key provider; }

	function has_node_access(provider) = provider.active and exists(node @? { provider });

    /* Can deploy blockchains on a container
    * - Deploy a blockchain to a container
    */
	entity deploy { key provider, container; }

	function has_deploy_access(provider, container) = provider.active and exists(deploy @? { provider, container });

}

namespace enroll {
	function system(provider) {
		create roles.system(provider);
		create voter_set_member(provider, system_p_voter_set());
		create cluster_provider(provider, system_cluster());
		create roles.deploy(provider, system_container());
		if (not(roles.has_node_access(provider))) node(provider);
	}

	function node(provider) {
		create roles.node(provider);
	}

	function deploy(governor: voter_set, container, provider) {
		require(container.cluster.governance == governor);
		create roles.deploy(provider, container);
	}
}

namespace revoke {
	function system(provider) {
		delete roles.system @ { provider };
		delete voter_set_member @ { provider, voter_set @ { "SYSTEM_P" }};
		delete cluster_provider @ { provider, cluster @ { "system" } };
		delete roles.deploy @ { provider, container @ { "system"} };
	}

	function node(provider) {
		delete roles.node @ { provider };
		// TODO inactivate all nodes?
	}

	// TODO: Revoke deploy access

}

// type of quota for a provider
enum provider_quota_type {
	max_nodes,
	max_actions_per_day
}

entity provider_quota {
	index tier: integer, provider_quota_type;
	mutable value: integer;
}

// Limit how much stuff provider can do to prevent abuse,
// such as starting billion nodes, etc.
entity provider_rl_state {
	key provider;
	mutable points: integer;
	mutable last_update: integer;
}

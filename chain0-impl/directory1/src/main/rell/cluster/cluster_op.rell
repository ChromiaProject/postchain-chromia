module;

import ^.*;
import ^^.model.*;
import ^^.common.*;
import ^^.common.cluster.*;

// Creates a cluster with a set of providers
operation create_cluster(my_pubkey: pubkey, name, governor_voter_set: text, provider_pubkeys: list<pubkey>) {
    val me = require_is_provider_with_rl(my_pubkey);
    val governor = require_voter_set(governor_voter_set);
    require_provider_auth_with_rl(me);
    create_cluster_impl(name, governor, provider_pubkeys); 
}

// Creates a cluster provided by the members of an existing voter set
operation create_cluster_from(my_pubkey: pubkey, name, governor_voter_set: text, provider_voter_set: text) {
    val me = require_is_provider_with_rl(my_pubkey);
    val governor = require_voter_set(governor_voter_set);
    val deployer_voter_set = require_voter_set(provider_voter_set);
    require_provider_auth_with_rl(me);
    create_cluster_impl(name, governor, voter_set_member @* { deployer_voter_set }.provider.pubkey);
}

operation remove_cluster(my_pubkey: pubkey, name) {
    val provider = require_is_provider_with_rl(my_pubkey);
    val cluster = require_cluster(name);
    require_cluster_governor(cluster, provider);
    require_cluster_available_for_removal(cluster);
    remove_cluster_impl(cluster);
}

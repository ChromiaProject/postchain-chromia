<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>sources</id>
    <formats>
        <format>tar.gz</format>
    </formats>

    <baseDirectory>directory1</baseDirectory>
    <fileSets>
        <fileSet>
            <directory>${rell.directory}</directory>
            <outputDirectory>./rell</outputDirectory>
            <includes>
                <include>**/*.rell</include>
            </includes>
            <excludes>
                <exclude>**/test/*</exclude>
                <exclude>**/chromia1/**/*</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
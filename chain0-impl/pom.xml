<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>postchain-chromia</artifactId>
        <groupId>net.postchain</groupId>
        <version>3.8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <modules>
        <module>directory1</module>
        <module>chromia1</module>
    </modules>

    <groupId>net.postchain.chain0</groupId>
    <artifactId>chain0-impl</artifactId>
    <name>Chain0 - Parent</name>
    <description>Parent module for chain0 implementations</description>

    <properties>
        <rell.directory>${project.parent.basedir}/rell</rell.directory>
        <rell.main.module>${project.artifactId}</rell.main.module>
        <postgres.host>localhost:5432</postgres.host>
<!--        <rellTestModules>common,roles,container,cluster,nm_api</rellTestModules>-->
        <rellTestModules>common.test.provider_quotas_test</rellTestModules>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>net.postchain.rell</groupId>
                <artifactId>rell-maven-plugin</artifactId>
                <inherited>false</inherited>
                <configuration>
                    <source>rell/src</source>
                </configuration>
                <executions>
                    <execution>
                        <id>devnet-compile</id>
                        <goals>
                            <goal>rell-compile</goal>
                        </goals>
                        <configuration>
                            <mainModule>delta</mainModule>
                        </configuration>
                    </execution>
                    <execution>
                        <id>rell-test</id>
                        <goals>
                            <goal>rell-test</goal>
                        </goals>
                        <configuration>
                            <testModule>${rellTestModules}</testModule>
                            <skip>${skipTests}</skip>
                            <dbUrl>jdbc:postgresql://${postgres.host}/postchain?user=postchain&amp;username=postchain&amp;password=postchain&amp;schema=${rell.main.module}</dbUrl>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>make-archive</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <descriptors>
                                    <descriptor>src/main/assembly/targz.xml</descriptor>
                                </descriptors>
                            </configuration>
                        </execution>
                        <execution>
                            <id>make-executable-jar</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>ci</id>
            <properties>
                <postgres.host>postgres</postgres.host>
            </properties>
        </profile>
    </profiles>

</project>
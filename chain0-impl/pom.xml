<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>postchain-mc</artifactId>
        <groupId>net.postchain</groupId>
        <version>3.7.0-SNAPSHOT-sub</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <modules>
        <module>directory1</module>
        <module>enterprise0</module>
        <module>chromia0</module>
    </modules>

    <groupId>net.postchain.chain0</groupId>
    <artifactId>chain0-impl</artifactId>

    <properties>
        <rell.directory>${project.basedir}/src/main/rell</rell.directory>
        <rell.main.module>${project.artifactId}</rell.main.module>
        <postgres.host>localhost:5432</postgres.host>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>rell-compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>java</goal>
                            </goals>
                            <configuration>
                                <mainClass>net.postchain.rell.RellCLIKt</mainClass>
                                <arguments>
                                    <argument>--batch</argument>
                                    <argument>--source-dir</argument>
                                    <argument>${rell.directory}</argument>
                                    <argument>${rell.main.module}</argument>
                                </arguments>
                                <classpathScope>test</classpathScope>
                                <executableDependency>
                                    <groupId>net.postchain.rell</groupId>
                                    <artifactId>rell</artifactId>
                                </executableDependency>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>make-archive</id>
                            <phase>package</phase>
                            <goals>
                                <goal>single</goal>
                            </goals>
                            <configuration>
                                <descriptors>
                                    <descriptor>${project.basedir}/src/main/assembly/targz.xml</descriptor>
                                </descriptors>
                            </configuration>
                        </execution>
                        <execution>
                            <id>make-executable-jar</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>ci</id>
            <properties>
                <postgres.host>postgres</postgres.host>
            </properties>
        </profile>
    </profiles>

</project>